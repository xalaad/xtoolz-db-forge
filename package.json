{
  "name": "@xtools/db-forge",
  "version": "0.5.0",
  "description": "Database CLI tool with terminal - interactive migrations and seeders for TypeORM and Sequelize",
  "author": "Alaa El-Daour",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xalaad/xtools-db-forge.git"
  },
  "homepage": "https://github.com/xalaad/xtools-db-forge.git#readme",
  "bugs": {
    "url": "https://github.com/xalaad/xtools-db-forge.git/issues"
  },
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "forge": "dist/cli.js",
    "db-forge": "dist/cli.js",
    "forge-db": "dist/cli.js",
    "forge-migrate": "dist/cli.js",
    "forge-config": "dist/cli.js",
    "forge-seed": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "rimraf dist coverage",
    "prebuild": "npm run clean",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --coverage --ci --reporters=default --reporters=jest-junit",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "typeorm",
    "sequelize",
    "cli",
    "database",
    "migrations",
    "seeders",
    "artisan",
    "nestjs",
    "terminal",
    "interactive",
    "hacker"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "dotenv": "^16.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "^4.0.0",
    "typeorm": "^0.3.0"
  },
  "peerDependenciesMeta": {
    "sequelize": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "sequelize": "^6.0.0"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "chalk": "^4.1.2",
    "prompts": "^2.4.2",
    "umzug": "^3.2.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.30",
    "@types/prompts": "^2.4.9",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  }
}
